# Copy to .env and load in BOTH startup terminals (see README).
# This file is a shell-compatible example; it is not loaded automatically.
SMART_HOME_API_PORT=3101

# Storage encryption key: separate 600-permission file, outside SMART_HOME_DATA_DIR.
# Required for production/https; local new stores generate a sibling <data-dir>.key.
# SMART_HOME_DATA_KEY_FILE=/absolute/private/path/data.key
# Only this exact direct proxy IP may supply X-Smart-Home-Client-IP. Never use a CIDR.
# SMART_HOME_TRUSTED_PROXY_IP=172.30.47.3

# Optional absolute directory for business state and authentication data.
# Default: backend/data. Changing it selects a different household data store.
# SMART_HOME_DATA_DIR=/absolute/path/to/smart-home-data

# Optional Home Assistant provider (backend only; never use a VITE_ prefix).
# HA_URL=http://127.0.0.1:8123
# HA_TOKEN=replace-with-a-long-lived-access-token
# Optional restriction to entity object IDs beginning with this prefix.
# HA_ENTITY_PREFIX=homeos_sim_
# Optional server-side JSON: {"light.example":{"id":"living","name":"客厅"}}
# HA_ROOMS_FILE=/absolute/path/to/ha-rooms.json

# Deployment mode (leave unset for local development).
# SMART_HOME_API_HOST=0.0.0.0
# SMART_HOME_DEPLOYMENT_MODE=https
# Optional temporary bootstrap token, at least 32 random characters; remove after setup.
# SMART_HOME_BOOTSTRAP_TOKEN=
