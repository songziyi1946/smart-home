SMART_HOME_DOMAIN=home.example.com
SMART_HOME_HOST_DATA_DIR=/srv/smart-home/data
SMART_HOME_UID=1000
SMART_HOME_GID=1000
SMART_HOME_LOCAL_PORT=3101
SMART_HOME_IMAGE_TAG=local
SMART_HOME_DATA_KEY_HOST_FILE=/srv/smart-home/secrets/data.key
# Change all three addresses together if this subnet conflicts with the server network.
SMART_HOME_DOCKER_SUBNET=172.30.47.0/24
SMART_HOME_APP_IP=172.30.47.2
SMART_HOME_CADDY_IP=172.30.47.3
