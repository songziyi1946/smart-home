{
  "name": "smart-home-device-simulator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=11"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:e2e": "node --import tsx test/e2e.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mqtt": "5.14.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "aedes": "0.51.3",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  }
}
